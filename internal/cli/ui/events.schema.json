{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/platten/qrvideotransfer/blob/main/internal/cli/ui/events.schema.json",
  "title": "qrvt --json output",
  "description": "Each line qrvt prints with --json is one object of this schema: a start line, any number of event lines, then one summary or error line; a failure before the job starts, such as a usage error, is a single error line. Nothing is written on standard error. Every string is stripped of control characters. Fields may be added in later versions; consumers should ignore what they do not know.",
  "oneOf": [
    { "$ref": "#/$defs/start" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/summary" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "start": {
      "description": "The job about to run.",
      "type": "object",
      "required": ["type", "command"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "start" },
        "command": { "type": "string", "description": "For example encode or decode" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "output": { "type": "string" },
        "video": { "$ref": "#/$defs/fields" },
        "stages": { "type": "array", "items": { "$ref": "#/$defs/stage" } }
      }
    },
    "event": {
      "description": "One progress event of the root package (qrvt.Event).",
      "type": "object",
      "required": ["type", "time", "stage", "kind", "done", "total"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "event" },
        "time": { "type": "string", "format": "date-time" },
        "stage": { "$ref": "#/$defs/stage" },
        "kind": { "enum": ["started", "progress", "finished", "stats", "warning", "unknown"] },
        "done": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "unit": { "enum": ["bytes", "frames", "blocks"] },
        "stats": { "$ref": "#/$defs/stats" },
        "warning": { "$ref": "#/$defs/warning" }
      }
    },
    "summary": {
      "description": "The outcome of a job that succeeded.",
      "type": "object",
      "required": ["type", "title", "fields"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "summary" },
        "title": { "type": "string" },
        "fields": { "$ref": "#/$defs/fields" },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } }
      }
    },
    "error": {
      "description": "The outcome of a job that failed; exit is the process exit code.",
      "type": "object",
      "required": ["type", "message", "exit"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "error" },
        "message": { "type": "string" },
        "guidance": { "type": "string" },
        "exit": { "type": "integer", "minimum": 1 }
      }
    },
    "stage": {
      "enum": ["none", "pack", "protect", "render", "encode-video", "decode-video", "demodulate", "repair", "verify", "unpack", "unknown"]
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "value"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["captures", "frames_seen", "frames_total", "clean_fraction", "raw_bit_errors", "codewords_ok", "blocks_ready", "blocks_total"],
      "additionalProperties": false,
      "properties": {
        "captures": { "type": "integer", "minimum": 0 },
        "frames_seen": { "type": "integer", "minimum": 0 },
        "frames_total": { "type": "integer", "minimum": 0 },
        "clean_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "raw_bit_errors": { "type": "number", "minimum": 0, "maximum": 1 },
        "codewords_ok": { "type": "integer", "minimum": 0 },
        "blocks_ready": { "type": "integer", "minimum": 0 },
        "blocks_total": { "type": "integer", "minimum": 0 }
      }
    },
    "warning": {
      "type": "object",
      "required": ["code", "text"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "text": { "type": "string" }
      }
    }
  }
}
